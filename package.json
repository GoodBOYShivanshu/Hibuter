{
  "name": "hibxy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hibxy \u2014 a small, fast habit & streak tracker that lives in your browser.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
